// pass.earnrate.dev: signs the Apple Wallet cheat-sheet pass. Deploy with
// `yarn pass:deploy`. Stateless: no storage bindings and no request logs.
// Secrets (wrangler secret put … --config pass/wrangler.jsonc): PASS_TYPE_ID,
// TEAM_ID, PASS_CERT_PEM, PASS_KEY_PEM, WWDR_PEM.
{
  "name": "earnrate-pass",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "earnrate:pass-bundle": "./bundle.gen.json" },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "routes": [{ "pattern": "pass.earnrate.dev", "custom_domain": true }],
  // Per IP, per Cloudflare location: plenty for a person.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1103",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
