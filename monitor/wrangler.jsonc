// Deploy with `yarn monitor:deploy`. Needs the GH_DISPATCH_TOKEN secret: a
// fine-grained token for this repo with Actions: read and write.
{
  "name": "earnrate-monitor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  // Keep in step with CRONS in src/monitor.ts.
  "triggers": { "crons": ["*/5 * * * *", "7 * * * *", "30 14 * * *"] },
}
