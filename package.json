{
  "name": "earnrate",
  "version": "0.1.1",
  "description": "Picks the best credit card from your wallet for a merchant, and explains why",
  "keywords": [
    "credit cards",
    "rewards",
    "cash back",
    "points",
    "mcp",
    "cli"
  ],
  "homepage": "https://earnrate.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwasley/earnrate.git"
  },
  "bugs": "https://github.com/cwasley/earnrate/issues",
  "author": "Collin Wasley",
  "license": "(MIT AND CC-BY-NC-4.0)",
  "mcpName": "io.github.cwasley/earnrate",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "earnrate": "./dist/cli/bin.js",
    "earnrate-mcp": "./dist/mcp/bin.js"
  },
  "files": [
    "dist",
    "data",
    "!data/sources.lock.json",
    "wallet.example.yaml"
  ],
  "scripts": {
    "earnrate": "node src/cli/bin.ts",
    "mcp": "node src/mcp/bin.ts",
    "check-sources": "node src/sources/bin.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "yarn build",
    "smoke:pack": "node scripts/smoke-pack.ts",
    "site:deploy": "WRANGLER_SEND_METRICS=false wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --coverage.include=src/**",
    "typecheck": "tsc",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "yarn typecheck && yarn lint && yarn format:check && yarn test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/server": "2.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.149.0"
  }
}
