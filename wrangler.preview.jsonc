// preview.earnrate.dev, deployed by `yarn site:preview` from whatever branch is
// checked out. No analytics, no IndexNow, nothing indexed.
{
  "name": "earnrate-preview",
  "main": "site/preview-worker.ts",
  "alias": { "earnrate:report-codes": "./site/report-codes.gen.json" },
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site-dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // The same wallet sync as earnrate.dev, against the live hosted server:
  // try it with a test wallet.
  "services": [{ "binding": "MCP", "service": "earnrate-mcp" }],
  // Short report links in a store of their own, so preview links never land
  // in earnrate.dev's.
  "kv_namespaces": [
    { "binding": "REPORTS", "id": "26c8d91d9dc243bcb582e6058803bf3d" },
  ],
  "ratelimits": [
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1106",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "routes": [{ "pattern": "preview.earnrate.dev", "custom_domain": true }],
}
