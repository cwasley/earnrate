// preview.earnrate.dev, deployed by `yarn site:preview` from whatever branch is
// checked out. No analytics, no IndexNow, nothing indexed.
{
  "name": "earnrate-preview",
  "main": "site/preview-worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site-dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // The same wallet sync as earnrate.dev, against the live hosted server:
  // try it with a test wallet.
  "services": [{ "binding": "MCP", "service": "earnrate-mcp" }],
  "routes": [{ "pattern": "preview.earnrate.dev", "custom_domain": true }],
}
