# A script-src policy would also have to allow the Web Analytics beacon
# Cloudflare injects.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The statement check's policy names the hashes of its script and styles, so
# the build adds its block to site-dist/_headers (site/statement.config.ts).
