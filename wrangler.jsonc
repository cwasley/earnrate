{
  "name": "earnrate",
  // Static files; the Worker runs only for /count and /api/* (site/worker.ts).
  "main": "site/worker.ts",
  // The codes a short report link may name (yarn site:build writes it).
  "alias": { "earnrate:report-codes": "./site/report-codes.gen.json" },
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": false },
  // earnrate.dev is the only address; no workers.dev or preview copies.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site-dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/count", "/api/*", "/r", "/r/*"],
  },
  // Opt-in wallet sync: /api/* reaches the hosted server (remote/) directly.
  // No storage of its own; the tokens stay in the visitor's cookie.
  "services": [{ "binding": "MCP", "service": "earnrate-mcp" }],
  // Event names and device kinds only (site/events.ts).
  "analytics_engine_datasets": [
    { "binding": "USAGE", "dataset": "earnrate_site_usage" },
  ],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1104",
      "simple": { "limit": 60, "period": 60 },
    },
    // Short report links one IP address can make (site/report-policy.ts).
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1105",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Short report links (/r, site/reports.ts): each report's string and its
  // delete key's hash, nothing else. The site's only stored data.
  "kv_namespaces": [
    { "binding": "REPORTS", "id": "ef21ca669ebb4a5587e380784959fbbe" },
  ],
  "routes": [
    { "pattern": "earnrate.dev", "custom_domain": true },
    // Kept attached for its DNS record and certificate. The zone's redirect
    // rule sends www to earnrate.dev with a 308 before the Worker runs.
    { "pattern": "www.earnrate.dev", "custom_domain": true },
  ],
}
