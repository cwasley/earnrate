{
  "name": "earnrate",
  "compatibility_date": "2026-10-01",
  // earnrate.dev is the only address; no workers.dev or preview copies.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site-dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "earnrate.dev", "custom_domain": true },
    // Kept attached for its DNS record and certificate. The zone's redirect
    // rule sends www to earnrate.dev with a 308 before the Worker runs.
    { "pattern": "www.earnrate.dev", "custom_domain": true },
  ],
}
