// Serves the built site (site-dist/, from `yarn site:build`) as static
// assets on Cloudflare (free). Deploy with `yarn site:deploy`.
{
  "name": "earnrate",
  "compatibility_date": "2026-10-01",
  // earnrate.dev is the only address; no workers.dev or preview copies.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site-dist",
  },
  "routes": [
    { "pattern": "earnrate.dev", "custom_domain": true },
    { "pattern": "www.earnrate.dev", "custom_domain": true },
  ],
}
